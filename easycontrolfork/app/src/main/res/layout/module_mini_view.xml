<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5.0dip"
        android:background="@drawable/background_cron"
        android:elevation="3.0dip">

        <LinearLayout
            android:id="@+id/mini_control_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4.0dip"
            android:background="@drawable/background_cron"
            android:backgroundTint="@color/background"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/button_small"
                android:layout_width="34.0dip"
                android:layout_height="30.0dip"
                android:paddingStart="8.0dip"
                android:paddingTop="7.0dip"
                android:paddingEnd="8.0dip"
                android:paddingBottom="4.0dip"
                android:src="@drawable/window_restore"
                android:tint="@color/onCardBackground" />

            <FrameLayout
                android:layout_width="15.0dip"
                android:layout_height="8.0dip"
                android:layout_gravity="center">

                <View
                    android:layout_width="15.0dip"
                    android:layout_height="2.0dip"
                    android:layout_gravity="center"
                    android:background="@drawable/background_cron"
                    android:backgroundTint="@color/clientBar"
                    android:focusable="false" />

            </FrameLayout>

            <ImageView
                android:id="@+id/button_full"
                android:layout_width="34.0dip"
                android:layout_height="30.0dip"
                android:paddingStart="8.0dip"
                android:paddingTop="4.0dip"
                android:paddingEnd="8.0dip"
                android:paddingBottom="7.0dip"
                android:src="@drawable/expand"
                android:tint="@color/onCardBackground"
                android:visibility="gone" />

        </LinearLayout>
    </FrameLayout>
</FrameLayout>
